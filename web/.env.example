# Server-only keys for Demo mode. Set these in Vercel, or in web/.env.local for local runs.
# Never add a VITE_ prefix: Vite copies VITE_ variables into the public page.
# These are the private keys of the testnet accounts listed in src/demo-config.js.
DEMO_KEY_M1=
DEMO_KEY_M2=
DEMO_KEY_M3=
# Optional. The default is https://test.rpc.fastnear.com
NEAR_RPC_URL=
